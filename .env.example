# Copy this file to .env, then set MESSAGE_GATEWAY_API_KEY.
# Generate a key with: openssl rand -hex 32
# Keep .env out of version control: chmod 600 .env
# Use the same key as MESSAGE_GATEWAY_API_KEY in clinic-backend/.env.

# ── HTTP API ──────────────────────────────────────────────────────────────
# Used by a host-run binary. Compose always listens on :8081 in the container.
HTTP_ADDR=:8081
MESSAGE_GATEWAY_PORT=8081
# Bearer token shared with clinic-backend.
MESSAGE_GATEWAY_API_KEY=
MESSAGE_SENDER_KEY=qq
MESSAGE_GATEWAY_IMAGE_TAG=latest

# ── NapCat connection ─────────────────────────────────────────────────────
# Compose runs NapCat at napcat:3001. For a host-run gateway use
# http://127.0.0.1:3001 instead.
NAPCAT_BASE_URL=http://napcat:3001
# Must match the OneBot HTTP server token configured in NapCat.
NAPCAT_ACCESS_TOKEN=
NAPCAT_TIMEOUT=10s
NAPCAT_DIRECTORY_REFRESH=30m
NAPCAT_DIRECTORY_RETRY=5s
NAPCAT_DIRECTORY_TIMEOUT=60s
NAPCAT_GROUP_TEMP_SESSION=true

# ── Bundled NapCat (profile: bundled-napcat) ──────────────────────────────
NAPCAT_IMAGE_TAG=latest
NAPCAT_UID=1000
NAPCAT_GID=1000
# QQ account to quick-login after the first QR login. Leave empty to scan the
# QR code in the WebUI.
NAPCAT_QUICK_ACCOUNT=
NAPCAT_ONEBOT_PORT=3001
NAPCAT_WEBUI_PORT=6099
NAPCAT_CONFIG_DIR=./napcat/config
NAPCAT_QQ_DIR=./napcat/QQ

# ── Queue and retry policy ────────────────────────────────────────────────
MESSAGE_QUEUE_SIZE=100
MESSAGE_SEND_TIMEOUT=30s
MESSAGE_MAX_ATTEMPTS=3
MESSAGE_RETRY_BACKOFF=2s

# ── Gap between sends ─────────────────────────────────────────────────────
# fixed:  base + jitter
# length: length base + per-rune delay + jitter
MESSAGE_GAP_MODE=fixed
MESSAGE_GAP_FIXED=3s
MESSAGE_GAP_LENGTH_BASE=1s
MESSAGE_GAP_PER_RUNE=50ms
MESSAGE_GAP_JITTER=1s
MESSAGE_GAP_MIN=1s
